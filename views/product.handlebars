<div class="main_content">
    <h1 id="title">Products</h1>

    <div class="filter-container">
        <div class="filter-group">

            <div class="filter-item">
                <label for="searchName">Product Name:</label>
                <input type="text" id="searchName" placeholder="Search products...">
            </div>

            <div class="filter-item">
                <label for="searchCategory">Category:</label>
                <select id="searchCategory">
                    <option value="">All Categories</option>
                    <option value="Gaming Laptop">Gaming Laptop</option>
                    <option value="Wireless Mouse">Wireless Mouse</option>
                    <option value="Mechanical Keyboard">
                        Mechanical Keyboard
                    </option>
                </select>
            </div>

            <div class="filter-item">
                <label for="searchBrand">Brand:</label>
                <select id="searchBrand">
                    <option value="">All Brands</option>
                    <option value="ASUS ROG">ASUS ROG</option>
                    <option value="Razer">Razer</option>
                    <option value="Arbiter">Arbiter</option>
                </select>
            </div>

            <div class="filter-item">
                <label for="minPrice">Minimum Price ($):</label>
                <input type="number" id="minPrice" placeholder="Minimum price...">
            </div>

            <div class="filter-item">
                <label for="maxPrice">Maximum Price ($):</label>
                <input type="number" id="maxPrice" placeholder="Maximum price...">
            </div>

            <button type="button" id="resetFilter">
                Reset Filters
            </button>

        </div>
    </div>
</div>